# Required
DATABASE_URL=postgresql://user:password@localhost:5432/sdg_nexus
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters

# Optional
# Public address of the site, used for links printed on credential PDFs (defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL=
# SDG tagging uses OpenAI when this is set, otherwise the built-in keyword classifier
OPENAI_API_KEY=
