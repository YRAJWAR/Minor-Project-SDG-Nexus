// ──────────────────────────────────────────────────────────────
// SDG Nexus — PostgreSQL Schema (Prisma ORM)
// Full-stack SDG Impact Intelligence Platform
// ──────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── 0. Roles & regions ──────────────────────────────────────

/// One spelling for every role, everywhere (API, UI, seed).
enum Role {
  CITIZEN
  OFFICER // district officer; jurisdiction = districtId
  FACULTY // university staff; university = heiId
  STUDENT // university student; university = heiId
  NGO // member of an NGO organisation
  CSR // member of a CSR (company) organisation
  ADMIN
}

/// All Indian states and union territories (seeded from prisma/data/india-regions.json).
model State {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  sdgIndex  Int? // NITI Aayog SDG India Index composite score; entered from the official report
  districts District[]

  @@map("states")
}

model District {
  id       Int    @id @default(autoincrement())
  name     String
  stateId  Int
  lat      Float? // centroid, added with the India map
  lng      Float?
  state    State  @relation(fields: [stateId], references: [id], onDelete: Cascade)
  officers User[]

  @@unique([stateId, name])
  @@index([stateId])
  @@map("districts")
}

// ─── 1. Users ────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  full_name     String
  email         String   @unique
  password_hash String
  avatar_url    String?
  role          Role     @default(CITIZEN)
  created_at    DateTime @default(now())

  // Officers act only within their district.
  districtId Int?
  district   District? @relation(fields: [districtId], references: [id])

  // NGO and CSR users belong to one organisation.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Faculty and students belong to one university.
  studentProfile StudentProfile?
  heiId          String?
  hei            HEI?            @relation("HEIUsers", fields: [heiId], references: [id])

  @@index([role])
  @@map("users")
}

// ─── 2. Organizations ────────────────────────────────────────

model Organization {
  id                  String   @id @default(uuid())
  name                String
  type                String
  logo_url            String?
  cover_image_url     String?
  registration_number String?  @unique
  country             String   @default("India")
  state               String
  district            String?
  verification_status String   @default("PENDING")
  created_at          DateTime @default(now())

  // Relations
  members         User[]
  projects        Project[]
  impact_scores   ImpactScore[]
  csr_allocations CSRAllocation[] @relation("CorporateCSR")
  risk_flags      RiskFlag[]

  @@index([type])
  @@index([state])
  @@index([district])
  @@index([verification_status])
  @@map("organizations")
}

// ─── 3. Projects ─────────────────────────────────────────────

model Project {
  id                   String   @id @default(uuid())
  organization_id      String
  title                String
  description          String
  cover_image_url      String?
  gallery_images       String?
  budget_allocated     Float
  budget_utilized      Float    @default(0)
  beneficiaries_count  Int      @default(0)
  outcome_metric_value Float? // 0–100 improvement %
  latitude             Float?
  longitude            Float?
  status               String   @default("DRAFT")
  created_at           DateTime @default(now())

  // Relations
  organization    Organization      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  sdg_tags        ProjectSDG[]
  activities      ProjectActivity[]
  csr_allocations CSRAllocation[]

  @@index([organization_id])
  @@index([status])
  @@index([organization_id, status]) // geo-impact-summary query optimization
  @@index([created_at(sort: Desc)])
  @@index([id]) // Donor tracking optimization
  @@map("projects")
}

// ─── 4. SDGs (Static lookup — seeded 1–17) ───────────────────

model SDG {
  id   Int    @id // 1–17
  name String

  // Relations
  project_sdgs ProjectSDG[]

  @@map("sdgs")
}

// ─── 5. ProjectSDGs (Many-to-Many) ───────────────────────────

model ProjectSDG {
  id                  String @id @default(uuid())
  project_id          String
  sdg_id              Int
  ai_confidence_score Float  @default(1.0)

  // Relations
  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  sdg     SDG     @relation(fields: [sdg_id], references: [id], onDelete: Cascade)

  @@unique([project_id, sdg_id])
  @@index([project_id])
  @@index([sdg_id])
  @@map("project_sdgs")
}

// ─── 6. ProjectActivities ────────────────────────────────────

model ProjectActivity {
  id             String   @id @default(uuid())
  project_id     String
  activity_title String
  description    String
  latitude       Float?
  longitude      Float?
  proof_url      String?
  hash_value     String
  created_at     DateTime @default(now())

  // Relations
  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@index([created_at(sort: Desc)])
  @@map("project_activities")
}

// ─── 7. ImpactScores ─────────────────────────────────────────

model ImpactScore {
  id                     String   @id @default(uuid())
  organization_id        String
  scale_score            Float
  outcome_score          Float
  efficiency_score       Float
  geographic_need_score  Float
  transparency_score     Float
  final_score            Float
  calculation_version    String   @default("1.0")
  raw_scale_value        Float?
  raw_outcome_value      Float?
  raw_efficiency_value   Float?
  raw_geo_value          Float?
  raw_transparency_value Float?
  calculated_at          DateTime @default(now())

  // Relations
  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([final_score(sort: Desc)]) // leaderboard queries
  @@index([calculated_at(sort: Desc)])
  @@map("impact_scores")
}

// ─── 9. CSRAllocations ───────────────────────────────────────

model CSRAllocation {
  id               String   @id @default(uuid())
  corporate_org_id String
  project_id       String
  amount_committed Float
  amount_disbursed Float    @default(0)
  financial_year   String
  created_at       DateTime @default(now())

  // Relations
  corporate_org Organization @relation("CorporateCSR", fields: [corporate_org_id], references: [id], onDelete: Cascade)
  project       Project      @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([corporate_org_id])
  @@index([project_id])
  @@index([financial_year])
  @@map("csr_allocations")
}

// ─── 11. RiskFlags ───────────────────────────────────────────

model RiskFlag {
  id              String   @id @default(uuid())
  organization_id String
  risk_type       String
  risk_level      String   @default("MEDIUM")
  description     String
  resolved        Boolean  @default(false)
  created_at      DateTime @default(now())

  // Relations
  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([risk_level])
  @@index([created_at(sort: Desc)])
  @@map("risk_flags")
}

// ─── 12. AuditLogs ───────────────────────────────────────────

model AuditLog {
  id             String   @id @default(uuid())
  actor_id       String
  actor_role     String
  action         String
  entity_type    String
  entity_id      String
  previous_value String?
  new_value      String?
  ip_address     String?
  seq            Int      @unique @default(autoincrement()) // append order; the chain follows this, not timestamps
  prev_hash      String? // hash of the previous entry: a chain, so editing any old entry breaks every later one
  hash           String?
  created_at     DateTime @default(now())

  @@index([entity_type, entity_id])
  @@index([actor_id])
  @@index([action])
  @@index([created_at(sort: Desc)])
  @@map("audit_logs")
}

// ══════════════════════════════════════════════════════════════
// HEI / Challenge / University Collaboration Models
// ══════════════════════════════════════════════════════════════

// ─── Enums ───────────────────────────────────────────────────

enum ChallengeStatus {
  SUBMITTED
  AI_PROCESSED
  VALIDATED
  UNIVERSITY_ASSIGNED
  TEAM_FORMED
  IN_PROGRESS
  COMPLETED
  DEPLOYED
  REJECTED // officer turned it down (reason stored)
  MERGED // folded into another report (mergedIntoId)
}

enum ProposalStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

enum MilestoneStatus {
  PENDING
  SUBMITTED
  GP_VERIFIED
  CSR_APPROVED
  REJECTED
}

// ─── 28. HEI (Higher Education Institution) ─────────────────

model HEI {
  id                   String              @id @default(cuid())
  name                 String
  ugcId                String              @unique
  state                String?
  district             String
  lat                  Float? // campus location, used for distance in matching
  lng                  Float?
  inviteCode           String              @unique @default(cuid()) // students/faculty join with this code
  departments          String[]
  sdgExpertise         Int[]
  naacGrade            String?
  pastPerformanceScore Float?              @default(0.5)
  isNewlyOnboarded     Boolean             @default(false)
  createdAt            DateTime            @default(now())
  users                User[]              @relation("HEIUsers")
  proposals            ChallengeProposal[]
  teams                ProjectTeam[]

  @@map("heis")
}

// ─── 29. StudentProfile ──────────────────────────────────────

model StudentProfile {
  id          String              @id @default(cuid())
  userId      String              @unique
  user        User                @relation(fields: [userId], references: [id])
  branch      String
  year        Int
  skills      String[]
  credits     Int                 @default(0)
  rating      Float               @default(0)
  teamMembers TeamMember[]
  credentials StudentCredential[]

  @@map("student_profiles")
}

// ─── 30. Challenge ───────────────────────────────────────────

model Challenge {
  id            String              @id @default(cuid())
  title         String
  description   String
  state         String?
  district      String
  block         String?
  gpsLat        Float?
  gpsLng        Float?
  category      String
  photoUrls     String[]
  videoUrls     String[]
  status        ChallengeStatus     @default(SUBMITTED)
  sdgTags       Int[]
  aiConfidence  Float?
  submittedBy   String
  submitterId   String? // the account that reported it (kept even when shown as anonymous)
  urgency       String              @default("NORMAL") // NORMAL | MODERATE | HIGH | CRITICAL
  rejectReason  String?
  mergedIntoId  String?
  submitterType String
  isAnonymous   Boolean             @default(false)
  isDuplicate   Boolean             @default(false)
  duplicateOf   String?
  gpVerified    Boolean             @default(false)
  submittedVia  String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  proposals     ChallengeProposal[]
  notifications Notification[]
  endorsements  Endorsement[]

  @@index([district])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("challenges")
}

// ─── 31. ChallengeProposal ───────────────────────────────────

model ChallengeProposal {
  id              String         @id @default(cuid())
  challengeId     String
  challenge       Challenge      @relation(fields: [challengeId], references: [id])
  heiId           String
  hei             HEI            @relation(fields: [heiId], references: [id])
  approach        String
  timelineWeeks   Int
  budgetRequested Float
  fundingSource   String?
  ipDeclaration   String
  status          ProposalStatus @default(DRAFT)
  aiQualityScore  Float?
  createdAt       DateTime       @default(now())
  team            ProjectTeam?

  @@index([challengeId])
  @@index([heiId])
  @@map("challenge_proposals")
}

// ─── 32. ProjectTeam ─────────────────────────────────────────

model ProjectTeam {
  id           String            @id @default(cuid())
  proposalId   String            @unique
  proposal     ChallengeProposal @relation(fields: [proposalId], references: [id])
  heiId        String
  hei          HEI               @relation(fields: [heiId], references: [id])
  facultyName  String
  facultyEmail String
  backupLead   String?
  members      TeamMember[]
  milestones   Milestone[]

  @@index([heiId])
  @@map("project_teams")
}

// ─── 33. TeamMember ──────────────────────────────────────────

model TeamMember {
  id               String         @id @default(cuid())
  teamId           String
  team             ProjectTeam    @relation(fields: [teamId], references: [id])
  studentProfileId String
  student          StudentProfile @relation(fields: [studentProfileId], references: [id])
  role             String

  @@index([teamId])
  @@index([studentProfileId])
  @@map("team_members")
}

// ─── 34. Milestone ───────────────────────────────────────────

model Milestone {
  id            String          @id @default(cuid())
  teamId        String
  team          ProjectTeam     @relation(fields: [teamId], references: [id])
  title         String
  description   String
  dueDate       DateTime
  status        MilestoneStatus @default(PENDING)
  proofUrls     String[]
  proofVideoUrl String?
  hashValue     String?
  gpsLat        Float?
  gpsLng        Float?
  exifTimestamp DateTime?
  verifierCode  String?
  fundReleased  Float?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([teamId])
  @@index([status])
  @@map("milestones")
}

// ─── 35. StudentCredential ───────────────────────────────────

model StudentCredential {
  id                String         @id @default(cuid())
  studentProfileId  String
  student           StudentProfile @relation(fields: [studentProfileId], references: [id])
  challengeTitle    String
  challengeDistrict String
  sdgTags           Int[]
  hoursContributed  Int
  creditPoints      Int
  nepCompliant      Boolean        @default(true)
  hashValue         String
  issuedAt          DateTime       @default(now())

  @@index([studentProfileId])
  @@map("student_credentials")
}

// ─── 36. Notification ────────────────────────────────────────

model Notification {
  id          String     @id @default(cuid())
  userId      String
  message     String
  entityType  String
  entityId    String
  read        Boolean    @default(false)
  priority    String     @default("P2")
  createdAt   DateTime   @default(now())
  challengeId String?
  challenge   Challenge? @relation(fields: [challengeId], references: [id])

  @@index([userId])
  @@index([read])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

// A citizen saying "this affects me too". One per user per challenge.
model Endorsement {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  createdAt   DateTime  @default(now())

  @@unique([challengeId, userId])
  @@map("endorsements")
}
